<Window x:Class="DuplicateFinder.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DupliKiller - Buscador de archivos duplicados"
        Height="760" Width="1280" MinHeight="600" MinWidth="1000"
        Icon="/Assets/app.ico"
        Background="{DynamicResource WindowBgBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="A" Modifiers="Control" Command="{Binding SelectAllGlobalCommand}"/>
        <KeyBinding Key="A" Modifiers="Control+Shift" Command="{Binding DeselectAllGlobalCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteToRecycleBinCommand}"/>
        <KeyBinding Key="F5" Command="{Binding StartScanCommand}"/>
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportResultsCommand}" CommandParameter="CSV"/>
        <KeyBinding Key="Escape" Command="{Binding DeselectAllGlobalCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== SIDEBAR ==================== -->
        <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="DupliKiller" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Buscador de duplicados" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="🌙" Style="{StaticResource IconButtonStyle}"
                            ToolTip="Cambiar tema" Command="{Binding ToggleThemeCommand}"
                            VerticalAlignment="Top"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="RUTAS A ESCANEAR" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <ListBox ItemsSource="{Binding ScanPaths}" Height="90">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding}" FontSize="11"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="✕" FontSize="9" Padding="3,0"
                                                Margin="4,0,0,0" Style="{StaticResource IconButtonStyle}"
                                                ToolTip="Quitar ruta"
                                                Command="{Binding DataContext.RemovePathCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="+ Agregar carpeta" Style="{StaticResource LinkButtonStyle}"
                                Command="{Binding AddPathCommand}" Margin="0,6,0,0" HorizontalAlignment="Left"/>

                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                                Margin="0,16,0,12"/>
                        <TextBlock Text="ESTADO" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding ScanSummary}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ScanPerformanceSummary}" FontSize="11"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0"/>
                        <TextBlock Margin="0,6,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"
                                   Text="{Binding CurrentFile, StringFormat={}Procesando: {0}}"/>
                        <Border Margin="0,10,0,0" Padding="12,10" Background="{DynamicResource WindowBgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <ProgressBar Value="{Binding ProgressCurrent}" Maximum="{Binding ProgressMax}"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Text="{Binding ProgressPercentage, StringFormat={}{0}%}"/>
                                    <TextBlock Grid.Column="1" FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" Text="{Binding ProgressText}"/>
                                    <TextBlock Grid.Column="2" FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding FilesScanned, StringFormat={}Archivos: {0}}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="MODO DE ESCANEO" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,16,0,6"/>
                        <ComboBox SelectedValue="{Binding SelectedScanModeText}"
                                  ItemsSource="{Binding ScanModeOptions}"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <Button Content="INICIAR" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding StartScanCommand}" Height="38"/>
                    <Button Content="CANCELAR" Style="{StaticResource SoftDangerButtonStyle}"
                            Command="{Binding CancelScanCommand}" Height="34" Margin="0,8,0,0"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                            Margin="0,12,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="F5 escanear · Ctrl+A todos · Supr papelera"
                                   FontSize="9" Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button Grid.Column="1" Content="⋯" Style="{StaticResource IconButtonStyle}"
                                Tag="{Binding}" Click="OpenMenu" ToolTip="Exportar y herramientas">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Exportar CSV"
                                              Command="{Binding PlacementTarget.Tag.ExportResultsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="CSV"/>
                                    <MenuItem Header="Exportar JSON"
                                              Command="{Binding PlacementTarget.Tag.ExportResultsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="JSON"/>
                                    <MenuItem Header="Exportar XML"
                                              Command="{Binding PlacementTarget.Tag.ExportResultsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="XML"/>
                                    <MenuItem Header="Exportar TXT"
                                              Command="{Binding PlacementTarget.Tag.ExportResultsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="TXT"/>
                                    <MenuItem Header="Ver log"
                                              Command="{Binding PlacementTarget.Tag.OpenLogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Acerca de"
                                              Command="{Binding PlacementTarget.Tag.OpenAboutCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== CONTENIDO ==================== -->
        <Grid Grid.Column="1" Margin="16,16,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Resultados" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ResultsSummary}" FontSize="11"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Todos" Style="{StaticResource LinkButtonStyle}"
                                Command="{Binding SelectAllGlobalCommand}" ToolTip="Seleccionar todos (Ctrl+A)"/>
                        <Button Content="Ninguno" Style="{StaticResource LinkButtonStyle}"
                                Command="{Binding DeselectAllGlobalCommand}" ToolTip="Deseleccionar todos (Ctrl+Shift+A)"/>
                        <ComboBox Width="150" Margin="8,0,8,0" ItemsSource="{Binding SortOptions}"
                                  SelectedItem="{Binding SelectedSortOption}"/>
                        <Button Content="≡" Style="{StaticResource IconButtonStyle}" Margin="0,0,-8,0"
                                Command="{Binding ToggleViewCommand}" ToolTip="{Binding ViewModeText}"/>
                    </StackPanel>
                </Grid>

                <ListBox Grid.Row="1" ItemsSource="{Binding Results}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         Margin="0,0,0,12">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBgBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16" SnapsToDevicePixels="True">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontSize="14" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Text="{Binding GroupNumber, StringFormat={}Grupo {0}}"/>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,2,0,0">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} copias · {1} c/u · {2} recuperables">
                                                        <Binding Path="CopyCount"/>
                                                        <Binding Path="FriendlySize"/>
                                                        <Binding Path="FriendlyReclaimable"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Copias" Style="{StaticResource LinkButtonStyle}"
                                                    ToolTip="Seleccionar todas las copias"
                                                    Command="{Binding DataContext.SelectAllInGroupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding Hash}"/>
                                            <Button Content="Ninguno" Style="{StaticResource LinkButtonStyle}"
                                                    ToolTip="Deseleccionar copias"
                                                    Command="{Binding DataContext.DeselectAllInGroupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding Hash}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="{DynamicResource OriginalBgBrush}"
                                            BorderBrush="{DynamicResource OriginalBorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="ORIGINAL" FontSize="9" FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding OriginalFile.Name}" FontSize="12"
                                                               FontWeight="SemiBold" Margin="8,0,0,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding OriginalFile.Path}"/>
                                                </StackPanel>
                                                <TextBlock FontSize="10"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="0,3,0,0"
                                                           Visibility="{Binding DataContext.IsDetailedView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                    <Run Text="{Binding OriginalFile.FriendlySize, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding OriginalFile.LastWriteTime, StringFormat={}{0:dd/MM/yyyy HH:mm}}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding OriginalFile.Extension}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="⋯" Style="{StaticResource IconButtonStyle}"
                                                    VerticalAlignment="Center"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    Click="OpenMenu" ToolTip="Acciones">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Ver original"
                                                                  Command="{Binding PlacementTarget.Tag.PreviewFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding OriginalFile.Path}"/>
                                                        <MenuItem Header="Abrir ubicación"
                                                                  Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding OriginalFile.Path}"/>
                                                        <MenuItem Header="Eliminar original"
                                                                  Command="{Binding PlacementTarget.Tag.DeleteSingleFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding OriginalFile.Path}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="{Binding CopyCount, StringFormat={}COPIAS ({0})}"
                                               FontSize="9" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,12,0,4"/>
                                    <ItemsControl ItemsSource="{Binding CopyFiles}"
                                                  VirtualizingStackPanel.IsVirtualizing="True"
                                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                                  ScrollViewer.CanContentScroll="True">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="0,0,0,1" Padding="2,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  VerticalAlignment="Center" Margin="0,0,10,0"
                                                                  ToolTip="Marcar para eliminar"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Path}"/>
                                                            <TextBlock FontSize="10"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       Margin="0,2,0,0"
                                                                       Visibility="{Binding DataContext.IsDetailedView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                                <Run Text="{Binding FriendlySize, Mode=OneWay}"/>
                                                                <Run Text=" · "/>
                                                                <Run Text="{Binding LastWriteTime, StringFormat={}{0:dd/MM/yyyy HH:mm}}"/>
                                                                <Run Text=" · "/>
                                                                <Run Text="{Binding Extension}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Content="⋯"
                                                                Style="{StaticResource IconButtonStyle}"
                                                                VerticalAlignment="Center" Margin="6,0,0,0"
                                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                Click="OpenMenu" ToolTip="Acciones">
                                                            <Button.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Header="Ver"
                                                                              Command="{Binding PlacementTarget.Tag.PreviewFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                              CommandParameter="{Binding Path}"/>
                                                                    <MenuItem Header="Abrir ubicación"
                                                                              Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                              CommandParameter="{Binding Path}"/>
                                                                    <MenuItem Header="Eliminar"
                                                                              Command="{Binding PlacementTarget.Tag.DeleteSingleFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                              CommandParameter="{Binding Path}"/>
                                                                </ContextMenu>
                                                            </Button.ContextMenu>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="{Binding CopyCount, StringFormat={}{0} copias duplicadas}"/>
                                        <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   Text="{Binding FriendlyReclaimable, StringFormat={}Liberables: {0}}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Sin resultados" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Ejecute un escaneo para buscar archivos duplicados." FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12,8" Margin="0,0,0,16"
                    Visibility="{Binding HasSelectedFiles, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} archivos seleccionados ({1})">
                                <Binding Path="SelectedFilesCount"/>
                                <Binding Path="FriendlySelectedReclaimableSpace"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="⋯" Style="{StaticResource IconButtonStyle}" Tag="{Binding}"
                                Click="OpenMenu" ToolTip="Más acciones">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Eliminar permanentemente"
                                              Command="{Binding PlacementTarget.Tag.DeletePermanentlyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Comprimir y Backup"
                                              Command="{Binding PlacementTarget.Tag.CompressBackupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Mover a..."
                                              Command="{Binding PlacementTarget.Tag.MoveFilesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Content="Eliminar seleccionados" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding DeleteToRecycleBinCommand}" Padding="16,8" Margin="8,0,0,0"
                                ToolTip="Mover a la Papelera de Reciclaje (Supr)"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
