<Window x:Class="DuplicateFinder.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acerca de DupliKiller" Width="400"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="/Assets/app.ico"
        Background="{DynamicResource WindowBgBrush}">
    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="16">
        <StackPanel Margin="28,20">
            <TextBlock Text="DupliKiller" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Buscador de archivos duplicados" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,2,0,0"/>

            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}" Margin="0,20,0,20"/>

            <TextBlock x:Name="VersionText" Text="Versión" FontSize="12"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Buscador de archivos duplicados para Windows 10/11"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,4,0,0"
                       TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,6,0,0">
                <Hyperlink NavigateUri="https://github.com/shoropio/duplikiller"
                           RequestNavigate="OnHyperlinkRequestNavigate">
                    github.com/shoropio/duplikiller
                </Hyperlink>
            </TextBlock>
            <TextBlock Text="© 2026 Shoropio Corporation. Todos los derechos reservados."
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,12,0,20"
                       TextWrapping="Wrap" TextAlignment="Center" />

            <Button Content="Aceptar" Width="100" HorizontalAlignment="Center" Padding="0,6"
                    Background="{DynamicResource AccentBrush}"
                    Click="OnAcceptClick"
                    IsDefault="True" />
        </StackPanel>
    </Border>
</Window>
